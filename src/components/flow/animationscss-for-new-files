@keyframes batteryBubble {
  0% {
    transform: translateY(0);
    opacity: 0.7;
  }
  80% {
    opacity: 0.5;
  }
  100% {
    transform: translateY(-100px);
    opacity: 0;
  }
}

.drop-shadow-glow-green {
  filter: drop-shadow(0 0 5px rgba(132, 204, 22, 0.7));
}

.drop-shadow-glow-red {
  filter: drop-shadow(0 0 5px rgba(239, 68, 68, 0.7));
}

.drop-shadow-glow-blue {
  filter: drop-shadow(0 0 5px rgba(59, 130, 246, 0.7));
}

@keyframes flowRight {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(300%);
  }
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.animate-pulse-slow {
  animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* Engine Vibration Animation */
@keyframes vibrate {
  0% {
    transform: translate(0);
  }
  20% {
    transform: translate(-2px, 2px);
  }
  40% {
    transform: translate(-2px, -2px);
  }
  60% {
    transform: translate(2px, 2px);
  }
  80% {
    transform: translate(2px, -2px);
  }
  100% {
    transform: translate(0);
  }
}

.animate-vibrate {
  animation: vibrate 0.3s linear infinite;
}

/* Smoke Particle Animation */
@keyframes smokeRise {
  0% {
    transform: translateY(0) scale(1);
    opacity: 0.4;
  }
  50% {
    opacity: 0.2;
  }
  100% {
    transform: translateY(-100px) scale(2);
    opacity: 0;
  }
}

.smoke-particle {
  position: absolute;
  background-color: rgba(100, 100, 100, 0.4);
  border-radius: 50%;
  animation: smokeRise 3s ease-out forwards;
}

/* Fan Rotation Animation */
@keyframes fanRotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.animate-fan-rotate {
  animation: fanRotate 1s linear infinite;
}

/* Heat Shimmer Animation */
@keyframes heatShimmer {
  0% {
    background-position: -100% 0;
  }
  100% {
    background-position: 100% 0;
  }
}

.animate-heat-shimmer {
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.1) 50%,
    transparent 100%
  );
  background-size: 200% 100%;
  animation: heatShimmer 2s linear infinite;
}

/* Weather Animations */
@keyframes sunRay {
  0% {
    transform: rotate(0deg);
    opacity: 0.5;
  }
  50% {
    opacity: 0.8;
  }
  100% {
    transform: rotate(360deg);
    opacity: 0.5;
  }
}

@keyframes cloudFloat {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

@keyframes rainfall {
  0% {
    transform: translateY(-100%);
  }
  100% {
    transform: translateY(100%);
  }
}

/* UI Animations */
@keyframes caret-blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

.animate-caret-blink {
  animation: caret-blink 1s step-end infinite;
}

/* Power Flow Animation */
@keyframes powerFlow {
  0% {
    transform: translateX(-100%);
    opacity: 0;
  }
  20% {
    opacity: 1;
  }
  80% {
    opacity: 1;
  }
  100% {
    transform: translateX(100%);
    opacity: 0;
  }
}

.animate-power-flow {
  animation: powerFlow 2s linear infinite;
}

/* Status Indicator Animations */
@keyframes ping {
  75%, 100% {
    transform: scale(2);
    opacity: 0;
  }
}

.animate-ping {
  animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
}
